rules_version = '2';
// Reglas TEMPORALES del proyecto de pruebas (operanzia-pruebas), solo mientras
// scripts/sembrar-pruebas.mjs mete los datos de ejemplo: únicamente la cuenta
// de siembra puede leer y escribir. El script vuelve a poner firestore.rules
// al terminar (también si falla). Nunca se despliegan en producción.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == "siembra@operanzia-pruebas.test";
    }
  }
}
