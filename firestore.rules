rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPERS ──────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // get() inside a rule is unrestricted by these same rules (Firestore
    // evaluates rule-internal get()/exists() calls without re-checking
    // rules), so this is safe to call from anywhere, including while
    // evaluating access to the caller's own usuarios doc.
    function myProfile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function myOrgId() {
      return myProfile().org_id;
    }

    function isSuperAdmin() {
      return isSignedIn() && myProfile().rol == 'superadmin';
    }

    // True only when both sides are a real, non-null org_id and they match.
    // (Two documents that both happen to be missing org_id must NOT be
    // treated as "same org" — that would let broken profiles see each
    // other's data.)
    function sameOrg(orgIdValue) {
      return isSignedIn() && orgIdValue != null && (orgIdValue == myOrgId() || esEspacioDeConcurso(orgIdValue));
    }

    // Espacio aislado de un concurso (licitación): «{org}--c-{concurso}». Sus
    // vehículos, plantilla, cuadrante, convenio y escenarios llevan ese
    // org_id, así que nunca se mezclan con la operativa. Solo entra la
    // oficina de la empresa (los conductores, nunca).
    function esEspacioDeConcurso(orgIdValue) {
      return orgIdValue is string && orgIdValue.matches('^' + myOrgId() + '--c-[A-Za-z0-9]+$') && puedeWorkspace();
    }

    // Workspace de gestión (Planning/Scheduling/Rostering/Control/Analytics,
    // más el planning de Rutas) — todo lo que no sea Field. superadmin ya
    // tiene acceso total vía la regla comodín de más abajo, así que no hace
    // falta repetirlo aquí.
    function puedeWorkspace() {
      return isSignedIn() && myProfile().rol in ['admin', 'intermedio'];
    }

    // planning_layers / planning_depots / planning_settings / scheduling_roster
    // are scoped by projectId, not org_id directly — resolve the owning
    // org via the parent scheduling_projects doc.
    function projectOrg(projectId) {
      return get(/databases/$(database)/documents/scheduling_projects/$(projectId)).data.org_id;
    }

    // Ficha por org+mes que todavía no existe: su ID empieza por el org_id
    // de quien la pide (p. ej. {org}_2026_09). Solo sirve para que la
    // escucha en vivo no falle antes de que se cree.
    function fichaPropiaSinCrear(docId) {
      return resource == null && docId.matches('^' + myOrgId() + '(--c-[A-Za-z0-9]+)?_.*'); // también las de un concurso (su espacio)
    }

    // ── SUPERADMIN: acceso total a todo ─────────────────────────────
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // ── ORGS ─────────────────────────────────────────────────────
    match /orgs/{orgId} {
      allow read: if isSignedIn() && orgId == myOrgId();
      allow write: if false; // solo superadmin (regla de arriba)
    }

    // ── USUARIOS ─────────────────────────────────────────────────
    match /usuarios/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || resource.data.org_id == myOrgId());

      // Alta de usuarios: el perfil lo crea SIEMPRE quien da de alta (un
      // admin o intermedio de esa organización, con su propia sesión; o el
      // superadmin, por la regla comodín), nunca el usuario nuevo a sí mismo.
      // Antes bastaba con que la organización existiera, y como el registro
      // de Firebase Auth está abierto y el ID de cada organización es su
      // nombre, cualquiera podía crearse una cuenta y un perfil de admin en
      // la organización de un cliente (corregido el 2026-10-05).
      //  · admin: puede dar de alta conductor, intermedio o admin;
      //  · intermedio: solo conductor;
      //  · siempre en su propia organización y nunca superadmin.
      allow create: if isSignedIn() && request.auth.uid != uid &&
        request.resource.data.org_id == myOrgId() &&
        request.resource.data.rol != 'superadmin' && (
          (myProfile().rol == 'admin' && request.resource.data.rol in ['conductor', 'intermedio', 'admin']) ||
          (myProfile().rol == 'intermedio' && request.resource.data.rol == 'conductor')
        );

      allow update: if isSignedIn() && (
        // El propio usuario puede editar su perfil, pero nunca su propio rol
        // (si no, cualquiera podría auto-promoverse a admin/superadmin con
        // un updateDoc directo, sin pasar por la UI).
        (request.auth.uid == uid && request.resource.data.rol == resource.data.rol) ||
        // Un admin de la misma org puede cambiar el rol de otros usuarios de
        // su org, pero nunca ascender a nadie a superadmin.
        (resource.data.org_id == myOrgId() && myProfile().rol in ['admin', 'superadmin'] &&
          request.resource.data.rol != 'superadmin') ||
        // Intermedio solo gestiona Field (activar/desactivar) — nunca puede
        // tocar otro Intermedio/Admin, ni usar esto para ascender a un
        // conductor a otro rol (el rol de destino tiene que seguir siendo
        // 'conductor').
        (resource.data.org_id == myOrgId() && myProfile().rol == 'intermedio' &&
          resource.data.rol == 'conductor' && request.resource.data.rol == 'conductor')
      ) && request.resource.data.org_id == resource.data.org_id; // org_id no se puede reasignar en un update

      allow delete: if false;
    }

    // ── PLANES / INCIDENCIAS / INVENTARIO / MOVIMIENTOS ─────────────
    // Mismo patrón: org_id como campo directo del documento, siempre
    // filtrado en el cliente por where("org_id","==",...).
    match /planes/{docId} {
      allow read: if sameOrg(resource.data.org_id);
      allow create: if sameOrg(request.resource.data.org_id);
      allow update, delete: if sameOrg(resource.data.org_id);
    }
    match /incidencias/{docId} {
      allow read: if sameOrg(resource.data.org_id);
      allow create: if sameOrg(request.resource.data.org_id);
      allow update, delete: if sameOrg(resource.data.org_id);
    }
    match /inventario/{docId} {
      allow read: if sameOrg(resource.data.org_id);
      allow create: if sameOrg(request.resource.data.org_id);
      allow update, delete: if sameOrg(resource.data.org_id);
    }
    match /movimientos/{docId} {
      allow read: if sameOrg(resource.data.org_id);
      allow create: if sameOrg(request.resource.data.org_id);
      allow update, delete: if sameOrg(resource.data.org_id);
    }
    // Avisos al móvil: la suscripción de cada persona (src/avisos.js). La da
    // de alta ella misma; la oficina de su organización la lee para enviarle
    // avisos y quita las caducadas.
    match /avisos_suscripciones/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || (sameOrg(resource.data.org_id) && puedeWorkspace()));
      allow create: if isSignedIn() && request.auth.uid == uid && (sameOrg(request.resource.data.org_id) || isSuperAdmin());
      allow update: if isSignedIn() && (
        (request.auth.uid == uid && (sameOrg(request.resource.data.org_id) || isSuperAdmin())) ||
        (sameOrg(resource.data.org_id) && puedeWorkspace() && request.resource.data.org_id == resource.data.org_id)
      );
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }
    // Pesadas de báscula (kg por camión, planta y fracción): las apunta la
    // oficina o el conductor en la planta; solo la oficina las corrige o borra.
    match /pesadas/{docId} {
      allow read: if sameOrg(resource.data.org_id);
      allow create: if sameOrg(request.resource.data.org_id);
      allow update, delete: if sameOrg(resource.data.org_id) && puedeWorkspace();
    }

    // ── SCHEDULING ───────────────────────────────────────────────
    // Datos del workspace de gestión — Field no tiene ningún caso de uso
    // aquí (vive entero dentro de planes/incidencias/inventario/
    // ubicaciones_activas/fichajes, sin tocar estas colecciones), así que
    // además de sameOrg() se exige puedeWorkspace() (admin/intermedio;
    // superadmin ya cubierto por la regla comodín de arriba).
    match /scheduling_vehicles/{docId} {
      allow read: if sameOrg(resource.data.org_id) && puedeWorkspace();
      allow create: if sameOrg(request.resource.data.org_id) && puedeWorkspace();
      allow update, delete: if sameOrg(resource.data.org_id) && puedeWorkspace();
    }
    match /scheduling_workers/{docId} {
      allow read: if sameOrg(resource.data.org_id) && puedeWorkspace();
      allow create: if sameOrg(request.resource.data.org_id) && puedeWorkspace();
      allow update, delete: if sameOrg(resource.data.org_id) && puedeWorkspace();
    }
    // ── CONCURSOS (licitaciones) ─────────────────────────────────────
    // La ficha de cada concurso, de la empresa. Su trabajo vive en su espacio.
    match /concursos/{concursoId} {
      allow read: if sameOrg(resource.data.org_id) && puedeWorkspace();
      allow create: if sameOrg(request.resource.data.org_id) && puedeWorkspace();
      allow update, delete: if sameOrg(resource.data.org_id) && puedeWorkspace() &&
        (request.resource == null || request.resource.data.org_id == resource.data.org_id);

      // Sus documentos (pliegos: lo leído, el texto y el PDF troceados)
      match /{sub}/{resto=**} {
        allow read, write: if sameOrg(get(/databases/$(database)/documents/concursos/$(concursoId)).data.org_id) && puedeWorkspace();
      }
    }

    match /scheduling_projects/{projectId} {
      allow read: if sameOrg(resource.data.org_id) && puedeWorkspace();
      allow create: if sameOrg(request.resource.data.org_id) && puedeWorkspace();
      allow update, delete: if sameOrg(resource.data.org_id) && puedeWorkspace();

      // Sin campos propios de tenant — el único límite es la ruta
      // (subcolección del proyecto), así que se resuelve el dueño vía el
      // documento padre.
      match /timetable/{entry} {
        allow read, write: if sameOrg(projectOrg(projectId)) && puedeWorkspace();
      }

      // Historial de versiones del escenario (solo métricas)
      match /scenario_history/{entry} {
        allow read, write: if sameOrg(projectOrg(projectId)) && puedeWorkspace();
      }
    }

    // Plantillas de restricciones de Scheduling (por organización)
    match /scheduling_constraint_templates/{docId} {
      allow read: if sameOrg(resource.data.org_id) && puedeWorkspace();
      allow create: if sameOrg(request.resource.data.org_id) && puedeWorkspace();
      allow update, delete: if sameOrg(resource.data.org_id) && puedeWorkspace();
    }

    // ── PLANNING (campo orgId, camelCase, y siempre por projectId) ──
    match /planning_layers/{docId} {
      allow read: if sameOrg(projectOrg(resource.data.projectId)) && puedeWorkspace();
      allow create: if sameOrg(projectOrg(request.resource.data.projectId)) && puedeWorkspace();
      allow update, delete: if sameOrg(projectOrg(resource.data.projectId)) && puedeWorkspace();

      // Puntos de las capas grandes, comprimidos y troceados (layer-store.js)
      match /trozos/{pieceId} {
        allow read, delete: if sameOrg(projectOrg(resource.data.projectId)) && puedeWorkspace();
        allow create, update: if sameOrg(projectOrg(request.resource.data.projectId)) && puedeWorkspace();
      }
    }
    // planning_depots / planning_settings / scheduling_roster: siempre un
    // único documento cuyo ID ES el projectId (nunca se listan), así que
    // se resuelve directamente por el propio ID del documento en vez de
    // fiarse de que el campo orgId esté siempre presente (algunos guardados
    // parciales con merge:true no lo re-escriben).
    match /planning_depots/{projectId} {
      allow read, write: if sameOrg(projectOrg(projectId)) && puedeWorkspace();
    }
    match /planning_settings/{projectId} {
      allow read, write: if sameOrg(projectOrg(projectId)) && puedeWorkspace();
    }
    // Escenario completo de Scheduling, comprimido y troceado (scenario-store.js)
    match /scheduling_scenarios/{projectId} {
      allow read, write: if sameOrg(projectOrg(projectId)) && puedeWorkspace();
      match /trozos/{pieceId} {
        allow read, write: if sameOrg(projectOrg(projectId)) && puedeWorkspace();
      }
    }
    // Inventario de contenedores, comprimido y troceado (inventario-store.js)
    match /planning_inventario/{projectId} {
      allow read, write: if sameOrg(projectOrg(projectId)) && puedeWorkspace();
      match /trozos/{pieceId} {
        allow read, write: if sameOrg(projectOrg(projectId)) && puedeWorkspace();
      }
    }
    match /scheduling_roster/{projectId} {
      allow read, write: if sameOrg(projectOrg(projectId)) && puedeWorkspace();

      // Turnos a cubrir y detalle diario troceados (límite de 1 MB por doc)
      match /partes/{partId} {
        allow read, write: if sameOrg(projectOrg(projectId)) && puedeWorkspace();
      }
    }

    // ── ROSTERING (ficha por org+mes, campo org_id) ─────────────────
    match /rostering/{docId} {
      allow read: if puedeWorkspace() && (sameOrg(resource.data.org_id) || fichaPropiaSinCrear(docId));
      allow write: if sameOrg(request.resource.data.org_id) && puedeWorkspace();

      // Cuadrante + asignaciones de cada trabajador ese mes (una ficha por
      // trabajador: en una sola pasaba de 1 MB con plantillas grandes)
      match /trabajadores/{workerId} {
        allow read: if sameOrg(resource.data.org_id) && puedeWorkspace();
        allow write: if sameOrg(request.resource.data.org_id) && puedeWorkspace();
      }
    }

    // ── PRECIOS POR PUNTO (Planning → Timetable, Analytics) ──────────
    // Solo administradores de la org del proyecto (ni intermedio ni
    // conductores); superadmin entra por la regla comodín.
    match /precios/{projectId} {
      allow read, write: if sameOrg(projectOrg(projectId)) && myProfile().rol == 'admin';
      match /trozos/{partId} {
        allow read, write: if sameOrg(projectOrg(projectId)) && myProfile().rol == 'admin';
      }
    }

    // ── CUADRANTE PUBLICADO A CADA TRABAJADOR (Rostering → Publicar) ──
    // Un doc por usuario y mes. Lo lee el propio trabajador en Rutas ("Mi
    // cuadrante") o un gestor; solo lo escriben los gestores.
    match /cuadrantes/{docId} {
      allow read: if sameOrg(resource.data.org_id)
        && (resource.data.uid == request.auth.uid || puedeWorkspace());
      allow create, update: if sameOrg(request.resource.data.org_id) && puedeWorkspace();
      allow delete: if sameOrg(resource.data.org_id) && puedeWorkspace();
    }

    // ── ROSTERING DE VEHÍCULOS (mismo patrón, disponibilidad por día) ──
    match /rostering_vehicles/{docId} {
      allow read: if puedeWorkspace() && (sameOrg(resource.data.org_id) || fichaPropiaSinCrear(docId));
      allow write: if sameOrg(request.resource.data.org_id) && puedeWorkspace();
    }

    // ── ERRORES DE LOS NAVEGADORES (error-report.js) ────────────────
    // Cualquiera con sesión puede registrar un error suyo, de su propia
    // organización. Solo el superadmin los lee (regla comodín).
    match /errores/{id} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.org_id == myOrgId();
      allow read, update, delete: if false;
    }

    // ── HISTORIAL DE CAMBIOS (audit.js) ─────────────────────────────
    // Registro de quién hizo qué: cada uno solo puede añadir líneas propias
    // de su organización, y nadie puede modificarlas ni borrarlas (salvo el
    // superadmin, por la regla comodín). Lo leen los usuarios de oficina.
    match /auditoria/{id} {
      allow read: if sameOrg(resource.data.org_id) && puedeWorkspace();
      allow create: if sameOrg(request.resource.data.org_id) && puedeWorkspace()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── PRESENCIA: quién está conectado (presence.js) ───────────────
    // Cada uno escribe solo su propia ficha y con su propia org; la leen
    // los de su misma organización (el superadmin, todas, por la regla
    // comodín).
    match /presencia/{uid} {
      allow read: if sameOrg(resource.data.org_id);
      allow create, update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.org_id == myOrgId();
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ── UBICACIÓN EN VIVO DEL CONDUCTOR ─────────────────────────────
    match /ubicaciones_activas/{uid} {
      allow read: if sameOrg(resource.data.org_id);
      // Solo el propio conductor puede escribir su documento — evita que
      // alguien falsifique la posición GPS de otro usuario.
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── LÍNEAS REGULARES: servicio publicado del día y posiciones ──────
    // La oficina (admin/intermedio) publica los turnos del día desde el
    // Scheduling; el conductor puede coger un turno libre (o soltar el suyo)
    // y anotar lo que va haciendo, pero no tocar los viajes ni el turno de otro.
    match /servicio_lineas/{sid} {
      allow read: if sameOrg(resource.data.org_id);
      allow create: if sameOrg(request.resource.data.org_id) && puedeWorkspace();
      allow update: if sameOrg(resource.data.org_id) && request.resource.data.org_id == resource.data.org_id && puedeWorkspace();
      allow delete: if sameOrg(resource.data.org_id) && puedeWorkspace();
      match /turnos/{tid} {
        allow read: if sameOrg(resource.data.org_id);
        allow create: if sameOrg(request.resource.data.org_id) && puedeWorkspace();
        allow delete: if sameOrg(resource.data.org_id) && puedeWorkspace();
        allow update: if sameOrg(resource.data.org_id) && request.resource.data.org_id == resource.data.org_id && (
          puedeWorkspace() || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['conductorUid', 'conductorNombre', 'real', 'inicioReal', 'finReal', 'actualizado'])
            && (resource.data.conductorUid == null || resource.data.conductorUid == request.auth.uid)
            && (request.resource.data.conductorUid == null || request.resource.data.conductorUid == request.auth.uid)
            // lo real solo lo anota quien tiene el turno (coger uno libre no toca nada más)
            && (resource.data.conductorUid == request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['conductorUid', 'conductorNombre', 'actualizado']))
          )
        );
      }
    }
    // Última posición de cada conductor de autobús (aparte de la de rutas por puntos)
    match /ubicaciones_lineas/{uid} {
      allow read: if sameOrg(resource.data.org_id);
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── FICHAJES (entrada/salida + kms de la jornada) ───────────────
    // Lectura: el propio conductor (su historial), o alguien con acceso al
    // workspace (control horario/laboral, panel de Control). Escritura:
    // solo el propio conductor puede fichar o cerrar su propio fichaje —
    // nadie puede fichar en nombre de otro ni tocar fichajes ajenos.
    // Solo se ficha cerca de un depot de la empresa (fichaje-depots.js): si la
    // empresa tiene depots, la entrada trae lugarEntrada y la salida
    // lugarSalida ({ p: proyecto, d: depot, lat, lng }) a menos de ~1 km de
    // ese depot. Aquí con un margen cuadrado (sin trigonometría en las
    // reglas): ±0,0095° de latitud (~1,05 km) y ±0,0125° de longitud (~1 km
    // en la Península). La app comprueba el círculo de 1 km de verdad.
    function depotsFichaje(org) {
      return get(/databases/$(database)/documents/depots_fichaje/$(org)).data.get('porProyecto', {});
    }
    function hayDepotsFichaje(org) {
      return exists(/databases/$(database)/documents/depots_fichaje/$(org)) && depotsFichaje(org).size() > 0;
    }
    function cercaDeDepot(org, l) {
      let deps = depotsFichaje(org);
      return l is map && l.p is string && l.d is string && l.lat is number && l.lng is number &&
        l.p in deps && l.d in deps[l.p] &&
        math.abs(l.lat - deps[l.p][l.d].lat) <= 0.0095 &&
        math.abs(l.lng - deps[l.p][l.d].lng) <= 0.0125;
    }
    function fichaEnDepot(org, datos, campo) {
      return !hayDepotsFichaje(org) || cercaDeDepot(org, datos.get(campo, null));
    }

    match /fichajes/{docId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        (sameOrg(resource.data.org_id) && puedeWorkspace())
      );
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        sameOrg(request.resource.data.org_id) &&
        fichaEnDepot(request.resource.data.org_id, request.resource.data, 'lugarEntrada');
      // cerrar el fichaje (la salida) también, cerca de un depot
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.org_id == resource.data.org_id &&
        (request.resource.data.get('estado', '') != 'cerrado' || resource.data.get('estado', '') == 'cerrado' ||
          fichaEnDepot(resource.data.org_id, request.resource.data, 'lugarSalida'));
      allow delete: if false;
    }

    // Depots de la empresa para fichar: los lee cualquiera de la empresa (el
    // conductor no puede leer los de cada proyecto); los pone al día la oficina.
    match /depots_fichaje/{orgId} {
      allow read: if sameOrg(orgId);
      allow write: if sameOrg(orgId) && puedeWorkspace();
    }
  }
}
