rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Superadmin: acceso total via get() al doc de usuario
    match /{document=**} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'superadmin';
    }

    // Orgs: cualquier usuario autenticado (solo superadmin llega al panel)
    match /orgs/{orgId} {
      allow read, write: if request.auth != null;
    }

    // Usuarios: lectura y creación para cualquier autenticado
    match /usuarios/{uid} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['admin', 'superadmin']
      );
      allow delete: if false;
    }

    // Planning / Scheduling: cualquier usuario autenticado
    match /planning_layers/{docId} {
      allow read, write: if request.auth != null;
    }
    match /planning_depots/{docId} {
      allow read, write: if request.auth != null;
    }
    match /planning_settings/{docId} {
      allow read, write: if request.auth != null;
    }
    match /scheduling_projects/{docId} {
      allow read, write: if request.auth != null;
      match /timetable/{entry} {
        allow read, write: if request.auth != null;
      }
    }
    match /scheduling_vehicles/{docId} {
      allow read, write: if request.auth != null;
    }
    match /scheduling_workers/{docId} {
      allow read, write: if request.auth != null;
    }
    match /scheduling_roster/{docId} {
      allow read, write: if request.auth != null;
    }
    match /rostering/{docId} {
      allow read, write: if request.auth != null;
    }

    // Otras colecciones usadas por la app del conductor (Rutas/Incidencias/Inventario)
    match /incidencias/{docId} {
      allow read, write: if request.auth != null;
    }
    match /inventario/{docId} {
      allow read, write: if request.auth != null;
    }
    match /movimientos/{docId} {
      allow read, write: if request.auth != null;
    }

    // Planes de ruta publicados desde Scheduling
    match /planes/{docId} {
      allow read, write: if request.auth != null;
    }

    // Ubicación en vivo del conductor (mapa de flota en Control).
    // Solo el propio conductor puede escribir su documento — evita que
    // alguien falsifique la posición GPS de otro usuario.
    match /ubicaciones_activas/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
